{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RL Trainer",
  "mainBinaryName": "rl-trainer",
  "identifier": "dev.wapeto.rltrainer",
  "build": {
    "frontendDist": "../../../ui/dist/desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RL Trainer",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2MDI0QkI5M0Q2MTI5MjEKUldRaEtXRTl1VXNDTnZXcVZTZG5Rd21idm1nQndIVzN3bkJWUlZRVDg5UXRORGZlWlhwcndWZ3EK",
      "endpoints": ["https://github.com/Wapeto/rl-trainer/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
